{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
   "target": "ES2020",
   "lib": ["ES2020", "DOM"],
   "module": "ESNext",
   "rootDir": "src",
   "outDir": "dist",
   "strict": true,
   "esModuleInterop": true,
   "skipLibCheck": true,
   "types": ["k6"],
   "moduleResolution": "Bundler",
   "resolveJsonModule": true,
   "allowJs": true,
   "noEmit": false
  },
  "include": ["src/**/*"]
}
